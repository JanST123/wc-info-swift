    "Ab welcher Distanz zur nächsten öffentlichen Toilette auf eine nähere geöffnete nicht-öffentliche ausgewichen wird.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The distance to the nearest public toilet above which a closer open non-public toilet is chosen as fallback."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ab welcher Distanz zur nächsten öffentlichen Toilette auf eine nähere geöffnete nicht-öffentliche ausgewichen wird."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vanaf welke afstand tot het dichtstbijzijnde openbare toilet wordt uitgeweken naar een dichterbij gelegen geopend niet-openbaar toilet."
          }
        }
      }
    },
